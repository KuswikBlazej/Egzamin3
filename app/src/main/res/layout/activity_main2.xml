<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="120px"
        android:text="Aktywność 2 - Podsumowanie"
        android:textSize="20dp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#255793"
        android:textColor="@android:color/white"></TextView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Podsumowanie Zamówienia"
        android:layout_margin="10dp"
        android:textSize="40dp"
        android:textStyle="bold"/>
    <androidx.cardview.widget.CardView
        app:cardElevation="30px"
        android:layout_width="800px"
        android:layout_height="600px"
        android:layout_gravity="center">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:layout_margin="20px">
            <ImageView
                android:layout_width="40px"
                android:layout_height="40px"
                android:src="@drawable/dot"
                android:layout_gravity="center"
                android:layout_margin="20px">

            </ImageView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rozmiar:"
                android:textSize="20dp"/>
            <TextView
                android:id="@+id/size2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Średnia"
                android:layout_marginLeft="10dp"
                android:textSize="20dp"/>
        </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20px">
                <ImageView
                    android:layout_width="40px"
                    android:layout_height="40px"
                    android:src="@drawable/palette"
                    android:layout_gravity="center"
                    android:layout_margin="20px">

                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ciasto:"
                    android:textSize="20dp"/>
                <TextView
                    android:id="@+id/thick2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="Grube"
                    android:layout_marginLeft="10dp"
                    android:textSize="20dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20px">
                <ImageView
                    android:layout_width="40px"
                    android:layout_height="40px"
                    android:src="@drawable/list"
                    android:layout_gravity="center"
                    android:layout_margin="20px">

                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sztuk:"
                    android:textSize="20dp"/>
                <TextView
                    android:id="@+id/count2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="2"
                    android:layout_marginLeft="10dp"
                    android:textSize="20dp"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="2px"
                android:background="@color/black"/>
            <TextView
                android:id="@+id/Total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Razem: 80,00 PLN"
                android:textAlignment="center"
                android:layout_marginTop="20dp"
                android:textSize="30dp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="#007700"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/Back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:backgroundTint="#255793"
        android:text="POWRÓT"
        android:textSize="20dp"></Button>

</LinearLayout>