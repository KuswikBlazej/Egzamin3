<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="120px"
        android:text="Aktywność 1 - Konfigurator"
        android:textSize="20dp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#255793"
        android:textColor="@android:color/white"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Konfigurator Pizzy"
        android:layout_margin="10dp"
        android:textSize="40dp"
        android:textStyle="bold"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Autor: 000000000000"
        android:textSize="20dp"
        android:layout_marginLeft="10dp"
        android:textColor="#7d8183"></TextView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_gravity="center"
        android:layout_margin="10dp"
        android:orientation="horizontal"
        android:gravity="center">
        <Spinner
            android:id="@+id/spinner1"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            android:textSize="20dp"/>

    <CheckBox
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Grube Ciasto"
        android:textSize="20dp"
        android:layout_marginLeft="10dp">
    </CheckBox>
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Liczba sztuk: "
            android:textSize="20dp"
            android:layout_marginLeft="10dp"/>
        <EditText
            android:layout_width="fill_parent"
            android:layout_height="match_parent"
            android:inputType="number">
        </EditText>
    </LinearLayout>
    </LinearLayout>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#255793"
        android:text="PRZEJDŹ DO PODSUMOWANIA"
        android:textSize="20dp"></Button>

</LinearLayout>